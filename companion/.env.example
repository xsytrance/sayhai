# Copy to .env and edit. Everything here has a sane default; nothing is required
# for Phase 0.

# --- Identity ---
# The creature's name. Becomes the wake word later, so pick something you'll
# enjoy saying. (Riff ideas: Pip, Squawk, Biscuit, Kiwi, Noodle, Waffles, Gort.)
CREATURE_NAME=Pip

# --- Server / window ---
HOST=127.0.0.1
PORT=8000
# true = open a fullscreen chrome-less pywebview window (the on-device feel).
# false = just run the server; open the URL in a browser (or Edge --kiosk).
USE_WEBVIEW=false

# --- Phase 1+: brain (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# --- Phase 1+: voice ---
VOICE_ENGINE=kokoro

# --- Phase 6: cloud voice (optional treat) ---
ELEVENLABS_API_KEY=

# --- Phase 3: phone channel ---
TELEGRAM_TOKEN=
