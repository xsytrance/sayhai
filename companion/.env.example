# Copy to .env and edit. Everything has a sane default; for Phase 1 the one thing
# you really want to set is OLLAMA_MODEL (a model you've actually pulled).

# --- Identity ---
# Becomes the wake word later. Used in the brain's personality prompt.
CREATURE_NAME=Chatty

# --- Server / window ---
# 0.0.0.0 = reachable from your phone on the same wi-fi (use http://<this-PC-ip>:8000/control).
# 127.0.0.1 = this machine only.
HOST=0.0.0.0
PORT=8000
# true = open a fullscreen chrome-less pywebview window (the on-device feel).
USE_WEBVIEW=false

# --- Phase 1: brain (Ollama) ---
OLLAMA_HOST=http://localhost:11434
# A small chat model you've pulled (e.g. ollama pull qwen3:4b). Qwen3 runs in
# NON-thinking mode here — skipping the hidden <think> tokens is the big speed win.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_PREDICT=120      # shorter = faster first audio; parrot quips are short
OLLAMA_TEMPERATURE=0.8
OLLAMA_NUM_CTX=2048         # smaller context = faster + less RAM (roommate problem)
OLLAMA_KEEP_ALIVE=30m       # keep the model warm between turns
HISTORY_TURNS=6             # rolling conversation context (RAM only; real memory is Phase 7)
WARMUP=true                 # prime brain + voice on startup so the first reply isn't cold

# --- Phase 1: voice (Kokoro) ---
VOICE_ENGINE=kokoro
KOKORO_MODEL=kokoro-v1.0.onnx
KOKORO_VOICES=voices-v1.0.bin
KOKORO_VOICE=af_heart       # try af_sarah, af_bella, am_adam, am_michael, bf_emma …
KOKORO_LANG=en-us

# --- Phase 2: ears (faster-whisper STT) ---
STT_MODEL=base.en           # tiny.en (fastest) · base.en · small.en (most accurate)
STT_DEVICE=cpu              # the Z1's iGPU isn't CUDA, so CPU int8 is the fast path
STT_COMPUTE=int8
STT_LANG=en                 # blank = auto-detect (slower)

# --- Phase 6: cloud voice (optional treat) ---
ELEVENLABS_API_KEY=

# --- Phase 3: phone channel (Telegram) ---
# Make a bot with @BotFather, paste the token here. Blank = Telegram off.
TELEGRAM_TOKEN=
TELEGRAM_VOICE=true          # also reply with a spoken voice note (needs ffmpeg)
TELEGRAM_ALLOWED_IDS=        # comma-separated Telegram user IDs; blank = anyone can talk to it

# --- Phase 4: senses (the nervous system) ---
SENSES_ENABLED=true
CHATTINESS=0.5               # how often it pipes up unprompted: 0 = never, 1 = chatty
WEATHER_LAT=                 # your latitude  (blank = auto-detect once by IP)
WEATHER_LON=                 # your longitude
