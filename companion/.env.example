# Copy to .env and edit. Everything has a sane default; for Phase 1 the one thing
# you really want to set is OLLAMA_MODEL (a model you've actually pulled).

# --- Identity ---
# Becomes the wake word later. Used in the brain's personality prompt.
CREATURE_NAME=Chatty

# --- Server / window ---
# 0.0.0.0 = reachable from your phone on the same wi-fi (use http://<this-PC-ip>:8000/control).
# 127.0.0.1 = this machine only.
HOST=0.0.0.0
PORT=8000
# true = open a fullscreen chrome-less pywebview window (the on-device feel).
USE_WEBVIEW=false

# --- Phase 1: brain (Ollama) ---
OLLAMA_HOST=http://localhost:11434
# A small chat model you've pulled, e.g.:  ollama pull llama3.2:3b
# 3B-class (Q4) keeps room for the voice (the roommate problem).
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_PREDICT=200      # cap reply length so it can't ramble into an essay
OLLAMA_TEMPERATURE=0.8
OLLAMA_KEEP_ALIVE=10m       # keep the model warm between turns
HISTORY_TURNS=8             # rolling conversation context (RAM only; real memory is Phase 7)

# --- Phase 1: voice (Kokoro) ---
VOICE_ENGINE=kokoro
KOKORO_MODEL=kokoro-v1.0.onnx
KOKORO_VOICES=voices-v1.0.bin
KOKORO_VOICE=af_heart       # try af_sarah, af_bella, am_adam, am_michael, bf_emma …
KOKORO_LANG=en-us

# --- Phase 6: cloud voice (optional treat) ---
ELEVENLABS_API_KEY=

# --- Phase 3: phone channel ---
TELEGRAM_TOKEN=
